{
  "name": "duet-blog",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run sync:notion && astro dev",
    "build": "npm run sync:notion && astro build",
    "preview": "astro preview",
    "tools:dev": "npm --prefix ../tools run dev -- --host 0.0.0.0 --port 4174",
    "tools:build": "npm --prefix ../tools run build",
    "tools:preview": "npm --prefix ../tools run preview",
    "astro": "astro",
    "check": "astro check",
    "sync:notion": "node ./tools/sync-notion.mjs",
    "clear:snyc:notion": "npm run sync:notion -- --reset --full",
    "deploy:cloudflare-hook": "node ./tools/trigger-cloudflare-deploy.mjs",
    "import:md": "node ./tools/sync-notion.mjs",
    "prepare": "npm run sync:notion"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1030.0",
    "@notionhq/client": "^5.18.0",
    "astro": "^5.4.2",
    "axios": "^1.15.0",
    "gray-matter": "^4.0.3",
    "marked": "^13.0.2",
    "notion-astro-loader": "^0.4.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.8",
    "@types/node": "^22.15.3",
    "concurrently": "^9.2.1",
    "typescript": "^5.9.3"
  }
}
