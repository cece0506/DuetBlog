---
import fs from "node:fs/promises";
import path from "node:path";

let showGalleryIntro = false;

try {
  const postsPath = path.join(process.cwd(), "public", "data", "posts.json");
  const content = await fs.readFile(postsPath, "utf8");
  const posts = JSON.parse(content);
  showGalleryIntro = Array.isArray(posts) && posts.length > 20;
} catch {
  showGalleryIntro = false;
}
---

<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Blog - Duet</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="stylesheet" href="/assets/css/style.css" />
</head>
<body class="has-tree-sidebar">
  <div class="site-shell site-shell-with-tree">
    <nav class="top-nav">
      <a class="brand" href="/">DUET<small>visual notes</small></a>
      <div class="nav-links">
        <a data-nav-link href="/">首页</a>
        <a data-nav-link href="/pages/blog.html">博客</a>
        <div class="tools-nav-group">
          <a data-nav-link href="/pages/tools.html">工具</a>
          <div class="tools-nav-menu" data-tools-menu></div>
        </div>
      </div>
    </nav>

    <aside class="side-nav" aria-label="侧边导航">
      <a data-nav-link href="/">首页</a>
      <a data-nav-link href="/pages/blog.html">博客</a>
      <a data-nav-link href="/pages/tools.html">工具</a>
      <button type="button" class="side-nav-top" data-scroll-top aria-label="回到顶部">顶部</button>
    </aside>

    <aside class="tree-sidebar" id="blog-tree-sidebar" aria-label="博客目录侧边栏">
      <button type="button" class="tree-sidebar-toggle" data-tree-toggle aria-expanded="true" aria-label="收起博客目录">目录</button>
      <div class="tree-sidebar-title">博客目录</div>
      <div class="tree-sidebar-body" data-tree-body></div>
    </aside>

    <header class="blog-head">
      <span class="kicker">Curated Writings</span>
      <p class="quote">WE DESIGN THE DAY, THEN THE DAY DESIGNS US.</p>
      <p id="blog-subtitle" class="blog-subtitle" hidden={!showGalleryIntro}>多行小卡片无边界滚动，鼠标划入暂停并聚焦当前内容。</p>
    </header>

    <section id="blog-gallery-shell" class="blog-gallery-shell" hidden={!showGalleryIntro}>
      <div class="gallery-lanes">
        <div class="gallery-lane" id="gallery-lane-a"></div>
      </div>
    </section>

    <section class="blog-filter-bar">
      <input id="blog-search" class="blog-search-input" type="search" placeholder="搜索博客标题或标签，例如 journal / rain" />
      <div id="blog-tags" class="blog-tags"></div>
    </section>

    <section>
      <h2 class="section-title">最新文章</h2>
      <p class="blog-result-count" id="blog-result-count"></p>
      <div class="post-list" id="post-list"></div>
      <div class="blog-pagination" id="blog-pagination"></div>
    </section>

    <section class="blog-date-nav-wrap">
      <h2 class="section-title">按日期浏览</h2>
      <div class="blog-date-nav" id="blog-date-nav"></div>
    </section>
  </div>

  <script src="../../scripts/main.ts"></script>
  <script src="../../scripts/blog.ts"></script>
  <script is:inline src="/assets/js/blog-tree.js"></script>
</body>
</html>
