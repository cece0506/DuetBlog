# Notion
NOTION_TOKEN=
NOTION_DATABASE_ID=

# Cloudflare R2
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT=

# Optional (default: https://img.duetpalace.top)
R2_PUBLIC_BASE_URL=https://img.duetpalace.top
R2_REGION=auto

# Cloudflare Pages Deploy Hook (optional for manual/local trigger)
CF_PAGES_DEPLOY_HOOK=

# Optional polling interval for sync-notion --watch (default 43200000 = 12h)
NOTION_POLL_MS=43200000