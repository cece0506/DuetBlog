# Notion
NOTION_TOKEN=
NOTION_DATABASE_ID=

# Cloudflare R2
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT=

# Optional
R2_PUBLIC_BASE_URL=
R2_REGION=auto

# Cloudflare Pages Deploy Hook (optional for manual/local trigger)
CF_PAGES_DEPLOY_HOOK=

# Cloudflare cache purge (optional, used by sync-notion)
CF_API_TOKEN=
ACCOUNT_ID=
CF_ZONE_ID=
# Optional comma-separated URLs for targeted purge. Leave empty to purge everything.
CF_PURGE_URLS=

# Sync failure notification webhook (optional)
SYNC_NOTIFY_WEBHOOK=

# GitHub Action deploy failure notification webhook (set in GitHub Secret: DEPLOY_NOTIFY_WEBHOOK)
# DEPLOY_NOTIFY_WEBHOOK=

# Optional polling interval for sync-notion --watch (default 43200000 = 12h)
NOTION_POLL_MS=43200000

# Optional fallback covers when Notion page has no cover
# Priority: R2 list (COVER_FALLBACK_PREFIX) + explicit URLs (COVER_FALLBACK_URLS)
COVER_FALLBACK_PREFIX=covers/
COVER_FALLBACK_URLS=

# Optional sync log retention days (default 7)
SYNC_LOG_RETENTION_DAYS=7

# Optional incremental sync controls
# true by default. Set false to force full scan every run.
NOTION_INCREMENTAL_SYNC=true
# Do a full refresh after this many hours even when incremental mode is enabled.
NOTION_FULL_REFRESH_HOURS=168