# Notion
NOTION_TOKEN=
NOTION_DATABASE_ID=

# Cloudflare R2
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT=

# Optional
R2_PUBLIC_BASE_URL=
R2_REGION=auto

# Cloudflare Pages Deploy Hook (optional for manual/local trigger)
CF_PAGES_DEPLOY_HOOK=

# Sync failure notification webhook (optional)
SYNC_NOTIFY_WEBHOOK=

# GitHub Action deploy failure notification webhook (set in GitHub Secret: DEPLOY_NOTIFY_WEBHOOK)
# DEPLOY_NOTIFY_WEBHOOK=

# Optional polling interval for sync-notion --watch (default 43200000 = 12h)
NOTION_POLL_MS=43200000